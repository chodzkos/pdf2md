# Override deweloperski — skopiuj do .env i uzupełnij klucze
# NIGDY nie commituj pliku .env!

# ── Klucze API ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Modele (opcjonalne — jeśli puste, używany jest domyślny dla providera) ───────
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
OLLAMA_MODEL=
